{
  "manifest_version": 3,
  "name": "Pantaw – KOL ER Checker for TikTok",
  "short_name": "Pantaw",
  "version": "0.1.0",
  "description": "Cek engagement rate (ER) kreator TikTok langsung di halaman profil: rata-rata views, likes, komentar. Dihitung lokal, tanpa server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
