{
  "manifest_version": 3,
  "name": "KOL ER Checker (TikTok)",
  "version": "0.1.0",
  "description": "Cek engagement rate kreator TikTok langsung di halaman profil. Semua hitungan lokal di browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.tiktok.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
